# Copy to .env and fill in. Required values are marked.

# --- Required ---------------------------------------------------------------
# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/voxen

# --- Required in production (NODE_ENV=production) ---------------------------
# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Outside production a random one is generated per boot, which invalidates
# sessions on every restart.
JWT_SECRET=

# Comma-separated list of browser origins allowed to call this API and open
# sockets. No trailing slash. e.g. https://voxen.app,https://www.voxen.app
CORS_ORIGINS=

# --- Optional ---------------------------------------------------------------
PORT=8000
NODE_ENV=development

# How long a session token stays valid (zeit/ms format).
JWT_EXPIRES_IN=7d

# Groq API key for live transcription (whisper-large-v3). Transcription
# returns 503 until this is set.
GROQ_API_KEY=

# Redis, for sharing room state across backend instances. Leave unset to keep
# state in-process — correct, but then the deployment must run exactly one
# instance, because two would each see half of every meeting.
REDIS_URL=

# Max bytes accepted per uploaded audio chunk. Default 8 MB.
MAX_AUDIO_BYTES=8388608
