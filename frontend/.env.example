# Copy to .env.local for local overrides, or set these in your host's build
# environment. All Vite client vars must be prefixed with VITE_ and are
# embedded in the published bundle — never put a secret here.

# Backend origin. Defaults to http://localhost:8000 in dev and the hosted
# backend in a production build.
VITE_SERVER_URL=

# TURN relay. Without one, calls fail behind symmetric NAT and many corporate
# firewalls — STUN alone can't traverse them. Comma-separated URLs.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
